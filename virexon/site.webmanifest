        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "assets/images/screenshots/mobile-home.webp",
      "sizes": "1080x1920",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Virexon Home Page - Mobile View"
    },
    {
      "src": "assets/images/screenshots/desktop-home.webp",
      "sizes": "1920x1080",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "Virexon Website - Desktop View"
    },
    {
      "src": "assets/images/screenshots/mobile-services.webp",
      "sizes": "1080x1920",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Virexon Services Page - Mobile View"
    }
  ],
  "display_override": ["standalone", "minimal-ui"],
  "prefer_related_applications": false,
  "related_applications": [],
  "share_target": {
    "action": "/share-target/",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "handle_links": "preferred",
  "edge_side_panel": {
    "preferred_width": 320
  }
}