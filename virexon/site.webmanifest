      "url": "/contact.html",
      "icons": [
        {
          "src": "assets/images/favicon/favicon-32x32.png",
          "sizes": "32x32"
        }
      ]
    },
    {
      "name": "Our Services",
      "short_name": "Services",
      "description": "View our technical services",
      "url": "/services.html",
      "icons": [
        {
          "src": "assets/images/favicon/favicon-32x32.png",
          "sizes": "32x32"
        }
      ]
    },
    {
      "name": "Get a Quote",
      "short_name": "Quote",
      "description": "Request a free quote for your property",
      "url": "/contact.html",
      "icons": [
        {
          "src": "assets/images/favicon/favicon-32x32.png",
          "sizes": "32x32"
        }
      ]
    },
    {
      "name": "Our Projects",
      "short_name": "Projects",
      "description": "View our premium projects",
      "url": "/projects.html",
      "icons": [
        {
          "src": "assets/images/favicon/favicon-32x32.png",
